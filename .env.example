# Primary provider is whichever key is set. If both are set, Gemini is primary and Groq is the fallback.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional, comma-separated. Each Gemini model has its own free-tier quota.
GEMINI_FALLBACK_MODELS=
GROQ_API_KEY=
GROQ_MODEL=
# Optional, for Groq reasoning models: low, medium or high.
GROQ_REASONING_EFFORT=
